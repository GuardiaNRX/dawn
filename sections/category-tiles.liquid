{% comment %}
  Kafle kategorii (cele zdrowotne)
  - 3–6 kafli, obraz, tytuł, opis, link
{% endcomment %}
<section class="section">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="title-wrapper">
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}
    <ul class="grid grid--2-col grid--3-col-tablet grid--3-col-desktop" role="list">
      {% for block in section.blocks %}
        <li class="grid__item" {{ block.shopify_attributes }}>
          <a
            class="card-wrapper underline-links-hover"
            href="{{ block.settings.link | default: '#' }}"
          >
            <div class="card card--media">
              <div class="card__inner">
                <div class="media media--square">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag:
                        widths: '300,600,900',
                        sizes: '(min-width: 990px) 33vw, 50vw',
                        alt: block.settings.title
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                  {% endif %}
                </div>
              </div>
              <div class="card__content">
                <div class="card__information">
                  <h3 class="card__heading h4">{{ block.settings.title }}</h3>
                  {% if block.settings.subtitle != blank %}
                    <p class="card__caption">{{ block.settings.subtitle }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Kafle kategorii (cele)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Zacznij od celu" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kafelek",
      "settings": [
        { "type": "text", "id": "title", "label": "Tytuł", "default": "Odporność" },
        { "type": "text", "id": "subtitle", "label": "Opis", "default": "Wit. C, D3+K2, cynk…" },
        { "type": "image_picker", "id": "image", "label": "Obraz" },
        { "type": "url", "id": "link", "label": "Link do kategorii/landing" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Kafle kategorii (cele)",
      "blocks": [
        { "type": "tile", "settings": { "title": "Odporność" } },
        { "type": "tile", "settings": { "title": "Sen i relaks" } },
        { "type": "tile", "settings": { "title": "Energia" } }
      ]
    }
  ]
}
{% endschema %}
