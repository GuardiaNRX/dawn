{%- liquid
  assign n = name | default: 'shipping'
-%}
{%- case n -%}
  {%- when 'secure' -%}
    <svg viewBox="0 0 24 24" role="img" aria-label="Bezpieczne płatności">
      <path d="M12 2l7 4v5c0 5-3.5 9.5-7 11-3.5-1.5-7-6-7-11V6l7-4zM9 12h6v2H9v-2z"/>
    </svg>
  {%- when 'return' -%}
    <svg viewBox="0 0 24 24" role="img" aria-label="Zwrot 14 dni">
      <path d="M12 5v3l4-4-4-4v3C6.5 3 2 7.5 2 13s4.5 10 10 10 10-4.5 10-10h-2c0 4.4-3.6 8-8 8s-8-3.6-8-8 3.6-8 8-8z"/>
    </svg>
  {%- when 'support' -%}
    <svg viewBox="0 0 24 24" role="img" aria-label="Wsparcie">
      <path d="M12 2a9 9 0 00-9 9v5a3 3 0 003 3h3v-8H6V11a6 6 0 1112 0v0h-3v8h3a3 3 0 003-3v-5a9 9 0 00-9-9z"/>
    </svg>
  {%- else -%}
    {# shipping #}
    <svg viewBox="0 0 24 24" role="img" aria-label="Szybka dostawa">
      <path d="M3 6h11v7h2.5l3-4H18V6h-2V4H3v2zm0 9h2a3 3 0 006 0h2a3 3 0 006 0h2v3h-2a3 3 0 01-6 0H11a3 3 0 01-6 0H3v-3z"/>
    </svg>
{%- endcase -%}
